ANTHROPIC_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here
RAPIDAPI_KEY=your_key_here

DATABASE_URL=postgresql+asyncpg://travel:travel@localhost:5432/travel_planner

# RapidAPI provider switches. Default off — free tiers have small monthly
# quotas, and the mock paths are the same code that runs on an API failure.
SKYSCANNER_ENABLED=False
BOOKING_ENABLED=False
AIRBNB_ENABLED=False
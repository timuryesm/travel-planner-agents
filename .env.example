ANTHROPIC_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here
RAPIDAPI_KEY=your_key_here

DATABASE_URL=postgresql+asyncpg://travel:travel@localhost:5432/travel_planner

# RapidAPI provider switches. Default off — free tiers have small monthly
# quotas, and the mock paths are the same code that runs on an API failure.
SKYSCANNER_ENABLED=False
BOOKING_ENABLED=False
AIRBNB_ENABLED=False

SECRET_KEY=change_me_to_a_long_random_string
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Registration gate. Empty = registration open (fine for local development).
# Set to any string in a deployed environment — without it, anyone with the
# URL can create an account and spend your Anthropic credits.
INVITE_CODE=